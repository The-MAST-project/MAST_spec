{
  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  // Formatting (fleet standard: ruff formatter; only reformat CHANGED lines on
  // save, so diffs stay small — see ruff.toml for the rules).
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modifications",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "editor.accessibilitySupport": "off",
  "terminal.integrated.accessibilitySupport": false,
  "files.eol": "\n",
  "python.analysis.autoImportCompletions": true,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  // The greateyes SDK wrapper is vendored upstream code, kept byte-identical to
  // the vendor archive (see cameras/greateyes/sdk/VENDOR.md) — its diagnostics
  // are not ours to fix. `ignore` rather than `exclude`: Pylance keeps analysing
  // the file so `import ... greateyesSDK as ge` still resolves in greateyes.py,
  // it just stops reporting problems located inside it. The equivalent ruff
  // exclusion lives in ruff.toml.
  "python.analysis.ignore": ["**/cameras/greateyes/sdk/greateyesSDK.py"],
  // Both entries mirror sys.path at runtime, so Pylance resolves what Python
  // resolves:
  //   ".."      — <top>, where the MAST_common sibling clone lives (the venv's
  //               mast.pth puts it on sys.path). Also set workspace-wide in
  //               mast-spec.code-workspace; repeated here because folder
  //               settings replace workspace settings rather than merging.
  //   the SDK   — the vendored Andor wrapper must be imported by its own
  //               top-level name `pyAndorSDK2`, because its __init__.py
  //               self-imports absolutely. cameras/andor/__init__.py puts this
  //               directory on sys.path for exactly that reason; without the
  //               same entry here, Pylance reports `import pyAndorSDK2` as
  //               unresolved and the obvious "fix" (spelling it as a repo path)
  //               silences Pylance while breaking the program at runtime. That
  //               is not hypothetical — it is what happened.
  "python.analysis.extraPaths": ["..", "cameras/andor/sdk/pyAndorSDK2"],
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ]
}
